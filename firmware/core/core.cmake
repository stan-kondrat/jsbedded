# Core and engine sources, shared by every platform build. Include it from the
# directory that creates the firmware target, then call jsb_apply_engine_options().
# Inputs (cache variables): JSB_BOARD, JSB_VERSION, JSB_ENGINE,
#   JSB_SCRIPT     boot script built into the image (default: core/boot.js)
#   JSB_BOARD_LED  GPIO of the on-board LED, empty if it is not a plain GPIO
#   JSB_STORAGE    ON if the platform implements the script drive (jsb_hal_disk_*,
#                  jsb_hal_drive_attach): adds storage/ and FatFs, defines JSB_STORAGE=1
#
# engines/<engine>/engine.cmake sets:
#   JSB_ENGINE_SOURCES          adapter + engine sources (required)
#   JSB_ENGINE_INCLUDE_DIRS     extra include directories
#   JSB_ENGINE_DEFINITIONS      extra compile definitions
#   JSB_ENGINE_COMPILE_OPTIONS  options for the engine sources only (e.g. -Wno-...)
#   JSB_ENGINE_LINK_LIBRARIES   extra libraries (e.g. m)

set(JSB_FIRMWARE_DIR ${CMAKE_CURRENT_LIST_DIR}/..)

if(NOT JSB_ENGINE)
    set(JSB_ENGINE none)
endif()
if(NOT EXISTS ${JSB_FIRMWARE_DIR}/engines/${JSB_ENGINE}/engine.cmake)
    message(FATAL_ERROR "unknown JSB_ENGINE=${JSB_ENGINE}: no engines/${JSB_ENGINE}/engine.cmake")
endif()

set(JSB_ENGINE_SOURCES)
set(JSB_ENGINE_INCLUDE_DIRS)
set(JSB_ENGINE_DEFINITIONS)
set(JSB_ENGINE_COMPILE_OPTIONS)
set(JSB_ENGINE_LINK_LIBRARIES)
include(${JSB_FIRMWARE_DIR}/engines/${JSB_ENGINE}/engine.cmake)

# Boot script -> C array (jsb_script, jsb_script_len, jsb_script_name in jsb/core.h).
if(NOT JSB_SCRIPT)
    set(JSB_SCRIPT ${JSB_FIRMWARE_DIR}/core/boot.js)
endif()
get_filename_component(JSB_SCRIPT ${JSB_SCRIPT} ABSOLUTE)
get_filename_component(_jsb_script_name ${JSB_SCRIPT} NAME)
set(JSB_SCRIPT_C ${CMAKE_BINARY_DIR}/jsb_script.c)

# ESP-IDF first reads component CMakeLists in script mode; generate only in the real configure.
if(NOT CMAKE_BUILD_EARLY_EXPANSION)
    if(NOT EXISTS ${JSB_SCRIPT})
        message(FATAL_ERROR "SCRIPT not found: ${JSB_SCRIPT}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${JSB_SCRIPT})
    file(READ ${JSB_SCRIPT} _jsb_hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _jsb_bytes "${_jsb_hex}")
    string(REPEAT "0x..," 16 _jsb_row)   # CMake regexes have no {n}
    string(REGEX REPLACE "(${_jsb_row})" "\\1\n    " _jsb_bytes "${_jsb_bytes}")
    file(WRITE ${JSB_SCRIPT_C}.tmp
"/* Generated by core/core.cmake from ${JSB_SCRIPT} - do not edit. */
#include <stddef.h>

const char jsb_script_name[] = \"${_jsb_script_name}\";
const unsigned char jsb_script[] = {
    ${_jsb_bytes}0x00
};
const size_t jsb_script_len = sizeof jsb_script - 1;
")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${JSB_SCRIPT_C}.tmp ${JSB_SCRIPT_C})
endif()

set(JSB_CORE_SOURCES
    ${JSB_FIRMWARE_DIR}/core/src/main.c
    ${JSB_FIRMWARE_DIR}/core/src/timers.c
    ${JSB_FIRMWARE_DIR}/core/src/board.c
    ${JSB_FIRMWARE_DIR}/api/console/console.c
    ${JSB_FIRMWARE_DIR}/api/gpio/gpio.c
    ${JSB_SCRIPT_C}
    ${JSB_ENGINE_SOURCES}
)

set(JSB_CORE_INCLUDE_DIRS
    ${JSB_FIRMWARE_DIR}/core/include
    ${JSB_FIRMWARE_DIR}/api/include
    ${JSB_FIRMWARE_DIR}/hal/include
    ${JSB_FIRMWARE_DIR}/engines/include
    ${JSB_ENGINE_INCLUDE_DIRS}
)

# Script drive: FatFs (third_party/fatfs, configured by storage/ffconf.h) + storage/.
if(JSB_STORAGE)
    get_filename_component(JSB_FATFS_DIR ${JSB_FIRMWARE_DIR}/../third_party/fatfs ABSOLUTE)
    list(APPEND JSB_CORE_SOURCES
        ${JSB_FIRMWARE_DIR}/storage/drive.c
        ${JSB_FIRMWARE_DIR}/storage/diskio.c
        ${JSB_FATFS_DIR}/ff.c
    )
    list(APPEND JSB_CORE_INCLUDE_DIRS
        ${JSB_FIRMWARE_DIR}/storage/include
        ${JSB_FIRMWARE_DIR}/storage
        ${JSB_FATFS_DIR}
    )
    if(NOT CMAKE_BUILD_EARLY_EXPANSION)
        set_source_files_properties(${JSB_FATFS_DIR}/ff.c PROPERTIES COMPILE_OPTIONS "-Os;-w")
    endif()
endif()

set(JSB_CORE_DEFINITIONS
    JSB_BOARD="${JSB_BOARD}"
    JSB_VERSION="${JSB_VERSION}"
    JSB_ENGINE="${JSB_ENGINE}"
    ${JSB_ENGINE_DEFINITIONS}
)
if(JSB_STORAGE)
    list(APPEND JSB_CORE_DEFINITIONS JSB_STORAGE=1)
endif()
if(NOT "${JSB_BOARD_LED}" STREQUAL "")
    list(APPEND JSB_CORE_DEFINITIONS JSB_BOARD_LED=${JSB_BOARD_LED})
endif()

set(JSB_CORE_LINK_LIBRARIES ${JSB_ENGINE_LINK_LIBRARIES})

# Source properties are per directory, so this runs where the target is created.
function(jsb_apply_engine_options)
    if(JSB_ENGINE_COMPILE_OPTIONS)
        set_source_files_properties(${JSB_ENGINE_SOURCES} PROPERTIES
            COMPILE_OPTIONS "${JSB_ENGINE_COMPILE_OPTIONS}")
    endif()
endfunction()
