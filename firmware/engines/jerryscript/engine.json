{
  "name": "jerryscript",
  "upstream": "https://github.com/jerryscript-project/jerryscript",
  "submodules": ["third_party/jerryscript"],
  "unsupported_boards": [],
  "language": "ES2015+ (es.next profile; no modules)",
  "language_level": "ES2015+",
  "min_flash_kb": null,
  "min_ram_kb": null,
  "license": "Apache-2.0",
  "features": {
    "let": true,
    "closures": true,
    "exceptions": true,
    "classes": true,
    "arrow_functions": true,
    "promises": true,
    "json": true,
    "stdlib_objects": true,
    "typed_arrays": true,
    "host_functions": false
  }
}
