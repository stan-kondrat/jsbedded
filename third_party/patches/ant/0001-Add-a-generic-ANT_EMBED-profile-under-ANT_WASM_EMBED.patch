diff --git a/include/embed.h b/include/embed.h
new file mode 100644
index 00000000..5f8d6a50
--- /dev/null
+++ b/include/embed.h
@@ -0,0 +1,45 @@
+#ifndef ANT_EMBED_H
+#define ANT_EMBED_H
+
+// Embed profile: Ant without an operating system (no mmap, libuv, threads or
+// filesystem). The embedder compiles the core with -DANT_EMBED=1 and provides
+// the host hooks below. The WebAssembly reactor (-DANT_WASM_EMBED=1) is one
+// such embedder; see wasm_embed.h.
+
+#ifdef ANT_EMBED
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "types.h"
+
+static_assert(
+  UINTPTR_MAX == UINT32_MAX,
+  "the embed profile assumes 32-bit pointers (wasm32, Cortex-M, Xtensa, RISC-V 32)"
+);
+
+// --- provided by the embedder ---
+
+// Monotonic time in milliseconds.
+double ant_embed_now_ms(void);
+
+// Fills buf with len random bytes (Math.random); returns 0, or -1 on failure.
+int ant_embed_random_fill(void *buf, size_t len);
+
+// Polled by the interpreter every 1024 dispatches while
+// js->embed_interrupt_enabled is set, and between microtasks; returning true
+// aborts the running script with a RangeError.
+bool ant_embed_should_interrupt(ant_t *js);
+
+// A failed internal assertion (ANT_ASSERT): report msg at file:line and stop.
+// Must not return.
+_Noreturn void ant_embed_fatal(const char *msg, const char *file, int line);
+
+// --- provided by Ant (src/embed/) ---
+
+// Drops every queued microtask, e.g. after an interrupt or before destroying js.
+void ant_embed_microtasks_reset(ant_t *js);
+
+#endif
+#endif
