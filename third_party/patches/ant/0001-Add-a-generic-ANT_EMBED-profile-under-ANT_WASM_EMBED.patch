@@ -0,0 +1,19 @@
+// Embed host hooks (embed.h) for the WebAssembly reactor: imports from the host.
+#include "wasm_embed.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+double ant_embed_now_ms(void) {
+  return ant_wasm_now_ms();
+}
+
+int ant_embed_random_fill(void *buf, size_t len) {
+  if (len > UINT32_MAX) return -1;
+  return ant_wasm_random_fill(buf, (uint32_t)len);
+}
+
+_Noreturn void ant_embed_fatal(const char *msg, const char *file, int line) {
+  fprintf(stderr, "ANT FATAL: %s\n  %s:%d\n", msg, file, line);
+  abort();
+}
