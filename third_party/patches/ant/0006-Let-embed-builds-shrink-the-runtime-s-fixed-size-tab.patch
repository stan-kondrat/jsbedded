+// Handle tables. Small embed targets override the sizes: the bucket arrays and
+// the external chunk table are static, and native functions are allocated in
+// slabs of CFUNC_SLAB_SIZE bytes.
+#ifndef ANT_EMBED_CFUNC_SLAB_SIZE
+#define ANT_EMBED_CFUNC_SLAB_SIZE (64 * 1024)
+#endif
+#ifndef ANT_EMBED_EXTERNAL_CHUNK_BITS
+#define ANT_EMBED_EXTERNAL_CHUNK_BITS 10
+#endif
+#ifndef ANT_EMBED_EXTERNAL_CHUNK_COUNT
+#define ANT_EMBED_EXTERNAL_CHUNK_COUNT 4096
+#endif
+#ifndef ANT_EMBED_REGISTRY_BUCKET_BITS
+#define ANT_EMBED_REGISTRY_BUCKET_BITS 11
+#endif
+
 enum {
+#ifdef ANT_EMBED
+  CFUNC_SLAB_SIZE = ANT_EMBED_CFUNC_SLAB_SIZE,
+  EXTERNAL_CHUNK_BITS = ANT_EMBED_EXTERNAL_CHUNK_BITS,
+  EXTERNAL_CHUNK_COUNT = ANT_EMBED_EXTERNAL_CHUNK_COUNT,
+  REGISTRY_BUCKET_BITS = ANT_EMBED_REGISTRY_BUCKET_BITS,
+#else
   CFUNC_SLAB_SIZE = 64 * 1024,
   EXTERNAL_CHUNK_BITS = 10,
-  EXTERNAL_CHUNK_SIZE = 1 << EXTERNAL_CHUNK_BITS,
   EXTERNAL_CHUNK_COUNT = 4096,
   REGISTRY_BUCKET_BITS = 11,
+#endif
+  EXTERNAL_CHUNK_SIZE = 1 << EXTERNAL_CHUNK_BITS,
   REGISTRY_BUCKET_COUNT = 1 << REGISTRY_BUCKET_BITS,
 };
 
