 bool ant_ptr_pair_put(ant_ptr_pair_map_t *map, uintptr_t key_a, uintptr_t key_b, ant_value_t value) {
+#if defined(ANT_EMBED) && defined(ANT_EMBED_COMPACT_TABLES)
+  // Small heaps: grow at 3/4 load instead of 1/2.
+  if (!map->entries || (map->len + 1) * 4 > (map->mask + 1) * 3) {
+#else
   if (!map->entries || (map->len + 1) * 2 > map->mask + 1) {
+#endif
     uint32_t cap = map->entries ? (map->mask + 1) * 2 : 16;
     ant_ptr_pair_entry_t *grown = calloc(cap, sizeof(*grown));
     if (!grown) return false;
diff --git a/src/shapes.c b/src/shapes.c
index 82721740..3729017e 100644
--- a/src/shapes.c
+++ b/src/shapes.c
@@ -35,8 +35,15 @@ static constexpr uint64_t SHAPE_IDX_TOMB = UINT64_MAX;
 
 static constexpr uint32_t SHAPE_IDX_MIN_CAP = 8;
 static constexpr uint32_t SHAPE_COMPACT_MIN_TOMBSTONES = 32;
+// Past this many properties an object gets its own shape that grows in place
+// instead of a new shared shape per added key; small heaps want it low.
+#if defined(ANT_EMBED) && defined(ANT_EMBED_SHAPE_TRANSITION_MAX_PROPS)
+static constexpr uint32_t SHAPE_TRANSITION_MAX_PROPS = ANT_EMBED_SHAPE_TRANSITION_MAX_PROPS;
+#else
 static constexpr uint32_t SHAPE_TRANSITION_MAX_PROPS = 1024;
+#endif
 static constexpr uint32_t SHAPE_KEYED_TRANSITION_MAX_PROPS = 32;
+static constexpr uint32_t SHAPE_INDEX_LAYOUT_MIN_PROPS = 1024;
 
 static constexpr size_t SHAPE_ENTRY_POOL_MAX = 1024;
 static constexpr size_t SHAPE_ENTRY_SIZE = sizeof(shape_child_entry_t);
@@ -220,9 +227,23 @@ static inline void shape_index_put(shape_index_entry_t *tab, uint32_t mask, uint
   tab[i].slot = slot;
 }
 
+// ANT_EMBED_COMPACT_TABLES trades a little lookup speed for memory: the index
+// fills to 3/4 before it grows and property arrays grow 8 entries at a time.
+#if defined(ANT_EMBED) && defined(ANT_EMBED_COMPACT_TABLES)
+static inline bool shape_index_full(uint32_t used, uint32_t cap) { return used * 4 >= cap * 3; }
+static inline uint32_t shape_props_next_cap(uint32_t cap, uint32_t needed) { (void)cap; return (needed + 7u) & ~7u; }
+#else
+static inline bool shape_index_full(uint32_t used, uint32_t cap) { return used * 2 >= cap; }
+static inline uint32_t shape_props_next_cap(uint32_t cap, uint32_t needed) {
+  uint32_t new_cap = cap ? cap * 2 : 8;
+  while (new_cap < needed) new_cap *= 2;
+  return new_cap;
+}
+#endif
+
 static uint32_t shape_index_capacity(uint32_t needed) {
   uint32_t cap = SHAPE_IDX_MIN_CAP;
-  while (cap <= needed * 2) cap *= 2;
+  while (shape_index_full(needed, cap)) cap *= 2;
   return cap;
 }
 
@@ -281,7 +302,7 @@ static bool shape_index_resize(ant_shape_t *shape, uint32_t needed) {
 
 static bool shape_index_add(ant_shape_t *shape, uint64_t key, uint32_t slot) {
   uint32_t cap = shape->descriptors->index ? shape->descriptors->index_mask + 1 : 0;
-  if ((shape->descriptors->index_used + 1) * 2 >= cap && !shape_index_resize(shape, shape->descriptors->index_used + 1)) return false;
+  if (shape_index_full(shape->descriptors->index_used + 1, cap) && !shape_index_resize(shape, shape->descriptors->index_used + 1)) return false;
 
   shape_index_put(shape->descriptors->index, shape->descriptors->index_mask, key, slot);
   shape->descriptors->index_used++;
@@ -309,9 +330,7 @@ static bool shape_ensure_capacity(ant_shape_t *shape, uint32_t needed) {
   uint32_t cap = shape->descriptors->cap;
   if (needed <= cap) return true;
 
-  uint32_t new_cap = cap ? cap * 2 : 8;
-  while (new_cap < needed) new_cap *= 2;
-  return shape_props_reserve(shape, new_cap);
+  return shape_props_reserve(shape, shape_props_next_cap(cap, needed));
 }
 
 static shape_descriptors_t *shape_descriptors_copy_prefix(const ant_shape_t *shape, uint32_t extra) {
@@ -713,7 +732,7 @@ ant_shape_t *ant_shape_clone_bulk(const ant_shape_t *shape, uint32_t extra) {
 }
 
 ant_shape_t *ant_shape_index_layout(ant_t *js, ant_shape_t **cache, const ant_shape_t *base, uint32_t count) {
-  if (count < SHAPE_TRANSITION_MAX_PROPS) return NULL;
+  if (count < SHAPE_INDEX_LAYOUT_MIN_PROPS) return NULL;
   
   ant_shape_t *cached = *cache;
   if (cached && cached->count == count && cached->inobj_limit == base->inobj_limit) return cached;
